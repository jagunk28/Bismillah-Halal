# GEMINI_API_KEY: Wajib diisi untuk pemanggilan Gemini AI API.
# Salin file ini menjadi .env.local lalu ganti nilainya dengan kunci API milikmu.
GEMINI_API_KEY="ISI_KUNCI_GEMINI_API_ANDA"

# APP_URL: URL tempat aplikasi ini di-hosting.
# Dipakai untuk tautan referensi diri, callback OAuth, dan endpoint API.
APP_URL="http://localhost:3000"
